<?xml version="1.0" encoding="utf-8"?>
<component>
    <name>org.freedesktop.IBus.buttre</name>
    <description>buttre Vietnamese IME</description>
    <exec>/usr/bin/buttre --ibus</exec>
    <version>0.9.6-beta</version>
    <author>buttre project</author>
    <license>MPL-2.0</license>
    <homepage>https://github.com/dxsl-org/buttre</homepage>
    <textdomain>buttre</textdomain>

    <!-- One engine per input method (Telex, VNI, Chữ Nôm, each keyboard TOML),
         generated by the binary each time ibus-daemon rebuilds its registry
         cache. Telex keeps the engine name "buttre". See ADR-0005. -->
    <engines exec="/usr/bin/buttre --ibus-engines"/>
</component>
