<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
      Id="*"
      Name="buttre"
      Language="1033"
      Version="$(var.Version)"
      Manufacturer="buttre project"
      UpgradeCode="8C5B151A-3EAC-4313-ACEA-E85BACB1CA82">
    <!--
      UPGRADE GUID: 8C5B151A-3EAC-4313-ACEA-E85BACB1CA82
      DO NOT CHANGE THIS GUID ACROSS VERSIONS — Windows uses it to detect "same product, newer version".
      Changing it forces a parallel install instead of an in-place upgrade, orphaning registry entries.

      TSF CLSID: E6B8A6C0-1234-5678-9ABC-DEF012345678
      Must match CLSID_buttre_TEXT_SERVICE in crates/buttre-platform/src/platforms/windows/tsf/mod.rs.

      TSF Profile GUID: B7447743-7652-4AB6-8D82-250D935EBCC0
      Language Profile GUID for vi-VN (LCID 0x042A). Choose once, never change.
    -->

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Description="buttre Vietnamese IME for Windows"
             Manufacturer="buttre project" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of buttre is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="MainFeature" Title="buttre" Level="1">
      <ComponentRef Id="CoreBinary" />
      <ComponentRef Id="TsfDll" />
      <ComponentGroupRef Id="KeyboardConfigs" />
      <?ifdef IncludeNomDb ?>
        <ComponentRef Id="NomDb" />
      <?endif ?>
    </Feature>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="buttre">

          <Component Id="CoreBinary" Guid="*">
            <File Id="ButtreExe"
                  Source="$(var.CargoTargetBinDir)\buttre.exe"
                  KeyPath="yes" />
          </Component>

          <Component Id="TsfDll" Guid="*">
            <File Id="ButtrePlatformDll"
                  Source="$(var.CargoTargetBinDir)\buttre_platform.dll"
                  KeyPath="yes" />
          </Component>

          <!--
            The TSF registration itself is NOT written here — see the
            RegisterTsf custom action below. It used to be hand-written
            registry rows, and that shipped a broken text service: a working
            TIP also needs its TSF CATEGORIES registered, which goes through
            ITfCategoryMgr (a COM call, not expressible as registry rows).
            Without them Windows showed the language instead of the IME's
            name and would not drive the service. The rows were also missing
            IconFile/IconIndex and had drifted from the code's own values.
          -->

          <Directory Id="KeyboardsDir" Name="keyboards">
            <Component Id="Kb_Cham" Guid="*">
              <File Source="$(var.CargoTargetBinDir)\keyboards\cham.toml" KeyPath="yes" />
            </Component>
            <Component Id="Kb_ChamAkharThrah" Guid="*">
              <File Source="$(var.CargoTargetBinDir)\keyboards\cham_akhar_thrah.toml" KeyPath="yes" />
            </Component>
            <Component Id="Kb_Hmong" Guid="*">
              <File Source="$(var.CargoTargetBinDir)\keyboards\hmong.toml" KeyPath="yes" />
            </Component>
            <Component Id="Kb_Khmer" Guid="*">
              <File Source="$(var.CargoTargetBinDir)\keyboards\khmer.toml" KeyPath="yes" />
            </Component>
            <Component Id="Kb_MuongTayNung" Guid="*">
              <File Source="$(var.CargoTargetBinDir)\keyboards\muong_tay_nung.toml" KeyPath="yes" />
            </Component>
            <Component Id="Kb_TayNguyen" Guid="*">
              <File Source="$(var.CargoTargetBinDir)\keyboards\taynguyen.toml" KeyPath="yes" />
            </Component>
            <Component Id="Kb_Thai" Guid="*">
              <File Source="$(var.CargoTargetBinDir)\keyboards\thai.toml" KeyPath="yes" />
            </Component>
          </Directory>

          <?ifdef IncludeNomDb ?>
            <Component Id="NomDb" Guid="*">
              <File Id="NomDbFile"
                    Source="$(var.CargoTargetBinDir)\buttre_nom.db"
                    KeyPath="yes" />
            </Component>
          <?endif ?>

        </Directory>
      </Directory>
    </Directory>

    <ComponentGroup Id="KeyboardConfigs">
      <ComponentRef Id="Kb_Cham" />
      <ComponentRef Id="Kb_ChamAkharThrah" />
      <ComponentRef Id="Kb_Hmong" />
      <ComponentRef Id="Kb_Khmer" />
      <ComponentRef Id="Kb_MuongTayNung" />
      <ComponentRef Id="Kb_TayNguyen" />
      <ComponentRef Id="Kb_Thai" />
    </ComponentGroup>

    <!--
      TSF registration, delegated to the product's own code
      (`registration::register_server`, the same path regsvr32 reaches through
      DllRegisterServer). One implementation, so the MSI can no longer drift
      from what the DLL expects — which is how it came to ship a text service
      registered without its categories.

      Deferred + Impersonate="no": these write HKLM, so they need the
      installer's elevated context, and deferred is the only phase where the
      files are already on disk.
    -->
    <CustomAction Id="RegisterTsf"
                  FileKey="ButtreExe"
                  ExeCommand="--register-tsf"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <!--
      Return="ignore" on the way out, unlike install: a registration that
      cannot be removed must never leave the user unable to uninstall. The
      leftover keys are inert once the DLL is gone.
    -->
    <CustomAction Id="UnregisterTsf"
                  FileKey="ButtreExe"
                  ExeCommand="--unregister-tsf"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <!-- After the DLL exists on disk; skipped when only removing. -->
      <Custom Action="RegisterTsf" After="InstallFiles">NOT REMOVE</Custom>
      <!-- Before the DLL is deleted, so the COM server is still loadable. -->
      <Custom Action="UnregisterTsf" Before="RemoveFiles">REMOVE="ALL"</Custom>
    </InstallExecuteSequence>

  </Product>
</Wix>
